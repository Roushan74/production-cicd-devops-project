# ---------------------------------------------------------------------------
# Example environment file. Copy to .env for local development:
#   cp .env.example .env
#
# These are NON-SECRET runtime settings. Real credentials (Docker Hub token,
# SonarQube token, SSH keys, AWS keys) must NEVER be placed in this file or
# committed to Git - they belong in GitHub Actions Secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Identity reported by GET /health (APP_VERSION is overwritten at build time)
APP_NAME=notes-api
APP_VERSION=1.0.0

# Logging: error | warn | info | debug
LOG_LEVEL=info

# Graceful shutdown grace period in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# Number of trusted reverse-proxy hops (1 = Nginx in front of the app)
TRUST_PROXY=1

# Upper bound on notes held in memory
MAX_NOTES=1000
